PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/swepp
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=7d
# Публичный URL фронта (без слэша в конце). Инвайты и строгий CORS.
# Dev: http://localhost:5173  |  VPS по IP: http://203.0.113.10  |  прод: https://example.com
# Если не задать — invite берётся из Host за reverse proxy; для локального вызова API — как dev fallback.
FRONTEND_URL=http://localhost:5173

# Локальный стресс: examples/stress_online.rs (десятки тысяч auth-запросов). Только для dev!
# DISABLE_RATE_LIMIT=1
